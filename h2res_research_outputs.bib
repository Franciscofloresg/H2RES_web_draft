  year         = {2019},
  howpublished = {Research project},
  abstract     = {INTERENERGY investigates the role of power-to-X and demand response technologies in supporting the transition from fossil-based energy systems to flexible, low-carbon systems with high shares of variable renewable energy. Within the context of increasingly coupled European energy markets, the project examines how these technologies can be integrated in a balanced and cost-effective manner, while avoiding unnecessary technological lock-ins. The research includes the development of new modelling modules to represent the operation of power-to-X and demand response technologies, their integration into long-term energy planning, and their participation in emerging market structures and business models. By identifying optimal technology combinations and market opportunities, INTERENERGY aims to provide recommendations for more reliable, digitalised, and sustainable energy systems, supporting renewable energy integration and the decarbonisation of multiple sectors. The project is implemented at the University of Zagreb, Faculty of Mechanical Engineering and Naval Architecture, from 1.12.2019. to 30.11.2023., leading researcher is prof. dr. sc. Neven Duić},
  institution  = {University of Zagreb, Faculty of Mechanical Engineering and Naval Architecture},
  note         = {Funded by the Croatian Science Foundation, project no. IP-2019-04-9482},
  url          = {https://interenergy.wp.fsb.hr/},
  keywords = {Energy planning, Power-to-X, Demand response technologies, Long term capacity planning, Power dispatch, Energy system decarbonization}
}

@misc{AI_NPT,
