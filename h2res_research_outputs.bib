@misc{Fovi2025,
author = {Feijoo, Felipe and Castaneda, Monica and Prieto, Ana Lucia and Matamala, Yolanda and Duic, Neven and Quoilin, Sylvain and Groppi, Daniele and Pastore, Lorenzo and Pfeifer, Antun and Beljan, Doris and Herc, Luka and Fernandez, Carlos and Kundu, Abhishake and Flores, Francisco},
  title        = { RES-JUST:Resilient Energy Systems for aJustTransitionthrough Multi-Scale Modeling},
  year         = {2025},
  howpublished = {Research project},
  abstract     = { RES-JUST aims to develop the capacities, models, and knowledge required to design resilient and just decarbonisation strategies for the Valparaíso Region and other regions of Chile. The project responds to the need to transform energy systems in the face of climate change by integrating renewable energy, storage, distributed energy, and flexibility technologies without deepening inequalities in access to energy, water, and other essential resources. Through a multidisciplinary approach combining integrated assessment models and energy system models, RES-JUST will analyse interactions among energy, water, land use, biodiversity, and the economy. Its results will support the evaluation of the costs and benefits of different transition strategies, strengthen technical capacities, and contribute to a more resilient, participatory, and equitable energy transition.},
  institution  = {School of Industrial Engineering, Pontificia Universidad Católica de Valparaíso, Valparaíso, Chile},
  note         = {Funded by the Agencia Nacional de Investigación y Desarrollo (Chile), cod: FOVI250263.},
  url          = { },
  keywords = { Just energy transition, Climate resilience, Resilient decarbonisation, Energy-water-land nexus, Renewable energy integration.}
}




