  title        = {AI-Aided Energy Planning for the Next Phase of Transition},
  year         = {2024},
  howpublished = {Research project},
  abstract     = {AI-NPT aims to improve long-term energy system modelling by combining a moving horizon approach with artificial intelligence. The project focuses on the electrification and decarbonisation of hard-to-abate sectors, particularly industry and transport, while addressing uncertainties such as changing resource availability and extreme weather conditions. Using deep learning, uncertainty analysis, and AI-based data preprocessing, the project will enable more flexible and computationally efficient modelling of multi-zone, multi-energy systems, including e-fuel production. Its outcomes will support more reliable renewable energy integration and more adaptable strategic planning for the energy transition.},
  institution  = {University of Zagreb, Faculty of Mechanical Engineering and Naval Architecture},
  note         = {Funded by the Croatian Science Foundation, project no. IP-2024-05},
  url          = {https://ainpt.wp.fsb.hr/},
  keywords = {Artificial intelligence, Energy system modelling, Moving horizon optimisation, Sector coupling, Renewable energy integration, E-fuels.}
}

